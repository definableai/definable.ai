/* Definable TUI — Base Styles */

Screen {
  background: $background;
}

Header {
  background: $primary-darken-3;
  color: $text;
  height: 1;
  dock: top;
}

/* Conversation scrollbar colors */
Conversation {
  scrollbar-background: $surface;
  scrollbar-color: $primary-darken-2;
  scrollbar-color-hover: $primary;
  scrollbar-color-active: $primary;
}

/* Code blocks inside markdown get subtle background */
AgentResponse MarkdownFence {
  background: $surface;
  margin: 1 0;
  padding: 1 2;
  border: round $primary-darken-3;
}

/* Tool call header collapsed state */
ToolCallBlock ToolCallHeader {
  color: $text-muted;
}

/* Thinking blocks */
ThinkingBlock ThinkingHeader {
  color: $text-muted;
}

/* Slash command completion popup */
SlashComplete {
  background: $surface;
}

SlashComplete .complete-header {
  background: $surface-darken-1;
}

/* Search bar */
SearchBar Input {
  background: $surface-darken-1;
}

/* Search match highlighting */
.search-match {
  background: $primary 25%;
}

.search-active {
  background: $warning 35%;
  border-left: thick $warning;
  text-style: bold;
}

/* Help modal */
HelpModal > Vertical {
  border: round $accent;
}

/* Prompt indicator states */
Prompt .prompt-running {
  color: $warning;
}

Prompt .prompt-ready {
  color: $accent;
}

/* Footer bar */
FooterBar {
  background: $primary-darken-3;
}

/* Status bar separator styling */
StatusBar .status-separator {
  color: $foreground-darken-3;
}

/* Tool call diff rendering */
ToolCallBlock .tool-result-log {
  background: transparent;
}
